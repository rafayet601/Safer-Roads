# ============================================================================
# Environment Configuration - Safe Driving Gamified Insurance App MVP
# ============================================================================
# 
# IMPORTANT: This file documents all required environment variables.
# DO NOT commit actual secrets to version control.
# 
# To set up your local environment:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in actual values for .env.local (this file stays as template)
# 3. .env.local is ignored by git - see .gitignore
#
# ============================================================================
# NODE ENVIRONMENT
# ============================================================================

# Node.js environment mode
NODE_ENV=development
# Options: development | staging | production

# ============================================================================
# DATABASE & PERSISTENCE
# ============================================================================

# PostgreSQL connection string for primary data store
# Local format: postgresql://username:password@host:port/database?schema=public
# Production: Use connection pooling (PgBouncer) and managed services (AWS RDS, Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safe_driving?schema=public"

# Redis connection details for caching and Bull Queue job processing
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: For Redis with authentication
# REDIS_PASSWORD=your-redis-password
# REDIS_URL=redis://:password@host:port

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT secret for signing and verifying tokens
# CRITICAL: Use a cryptographically secure random string (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use default values in production!
JWT_SECRET="dev-secret-change-in-production-must-be-32-characters-minimum"

# JWT token expiration time (in seconds)
# Default: 86400 = 24 hours
JWT_EXPIRY_SECONDS=86400

# ============================================================================
# SERVICE PORTS
# ============================================================================

# Each microservice runs on a separate port for development
# In production, use reverse proxy (Nginx/ALB) to route requests

# API Gateway (main entry point for all client requests)
GATEWAY_PORT=3100

# Microservices (internal communication only in production)
USER_SERVICE_PORT=3000
TRIP_SERVICE_PORT=3001
SCORING_SERVICE_PORT=3002
DASHBOARD_SERVICE_PORT=3003
REWARDS_SERVICE_PORT=3004
PRICING_SERVICE_PORT=3005
ADMIN_SERVICE_PORT=3006

# ============================================================================
# LOGGING & OBSERVABILITY
# ============================================================================

# Logging level for console output
LOG_LEVEL=debug
# Options: error | warn | info | debug | trace

# Enable structured logging (JSON format)
STRUCTURED_LOGGING=true

# Correlation ID prefix for tracing requests across services
CORRELATION_ID_PREFIX=safe-driving

# ============================================================================
# RATE LIMITING & PERFORMANCE
# ============================================================================

# Rate limit: requests per minute per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Request timeout (milliseconds)
REQUEST_TIMEOUT_MS=30000

# ============================================================================
# BUSINESS RULES - SCORING ENGINE
# ============================================================================

# Speeding thresholds (m/s)
SPEEDING_THRESHOLD_MS=20.0    # 20 m/s = 72 km/h

# Harsh braking threshold (m/s²)
HARSH_BRAKING_THRESHOLD=0.7

# Harsh acceleration threshold (m/s²)
HARSH_ACCELERATION_THRESHOLD=0.7

# Speeding severity thresholds for point deductions
SPEEDING_MILD_THRESHOLD=22.0  # 22 m/s = 79 km/h
SPEEDING_MODERATE_THRESHOLD=25.0  # 25 m/s = 90 km/h
SPEEDING_SEVERE_THRESHOLD=30.0  # 30 m/s = 108 km/h

# Point deductions (out of 100)
SPEEDING_MILD_DEDUCTION=2
SPEEDING_MODERATE_DEDUCTION=5
SPEEDING_SEVERE_DEDUCTION=10
HARSH_BRAKING_DEDUCTION=5
HARSH_ACCELERATION_DEDUCTION=3
PHONE_DISTRACTION_DEDUCTION=15

# ============================================================================
# BUSINESS RULES - GAMIFICATION
# ============================================================================

# Points per event type
POINTS_PER_PERFECT_TRIP=100
POINTS_PER_STREAK_BONUS=10
POINTS_STREAK_MILESTONE=5

# Streak tracking
MIN_TRIPS_FOR_STREAK=1
STREAK_BREAK_THRESHOLD=75  # Score below this breaks streak

# ============================================================================
# BUSINESS RULES - PRICING/SAVINGS
# ============================================================================

# Base premium (annual, in dollars)
BASE_PREMIUM_USD=1200

# Savings tiers based on average trip score
# Example: average score >= 90 = platinum tier with 20% savings
PLATINUM_MIN_SCORE=90
PLATINUM_SAVINGS_PERCENT=20

GOLD_MIN_SCORE=80
GOLD_SAVINGS_PERCENT=15

SILVER_MIN_SCORE=70
SILVER_SAVINGS_PERCENT=10

BRONZE_MIN_SCORE=60
BRONZE_SAVINGS_PERCENT=5

# ============================================================================
# EXTERNAL SERVICES (Future Integrations)
# ============================================================================

# Telemetry data ingestion (future: AWS Kinesis, Apache Kafka)
# TELEMETRY_ENDPOINT="https://telemetry.example.com"
# TELEMETRY_API_KEY="your-api-key"

# Email service (SendGrid, AWS SES, etc.)
# EMAIL_PROVIDER="sendgrid"
# EMAIL_API_KEY="your-email-api-key"
# EMAIL_FROM="noreply@safedrivingapp.com"

# SMS/Push notifications (Twilio, Firebase Cloud Messaging)
# TWILIO_ACCOUNT_SID="your-account-sid"
# TWILIO_AUTH_TOKEN="your-auth-token"
# FIREBASE_PROJECT_ID="your-firebase-project"

# Analytics (Mixpanel, Segment, Amplitude)
# ANALYTICS_API_KEY="your-analytics-key"

# ============================================================================
# FEATURE FLAGS (Future Use)
# ============================================================================

# Enable/disable experimental features in production
FEATURE_GAMIFICATION_ENABLED=true
FEATURE_SAVINGS_SIMULATOR_ENABLED=true
FEATURE_ADMIN_CONSOLE_ENABLED=true
FEATURE_EXPORT_TRIPS_ENABLED=false

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================

# Enable verbose SQL query logging (Prisma)
DEBUG_PRISMA=false

# Enable debug output from Bull Queue
DEBUG_BULL_QUEUE=false

# Mock external services (for testing without dependencies)
MOCK_TELEMETRY_SERVICE=false
MOCK_EMAIL_SERVICE=false

# ============================================================================
# SECURITY BEST PRACTICES CHECKLIST
# ============================================================================
#
# Before pushing to production:
#
# ✓ Change JWT_SECRET to a cryptographically secure random value
# ✓ Use strong PostgreSQL password (not 'postgres')
# ✓ Enable Redis authentication (REDIS_PASSWORD)
# ✓ Set NODE_ENV=production (disables debug output, enables caching)
# ✓ Use managed database services (AWS RDS, Azure Database, Google Cloud SQL)
# ✓ Set up VPN/security group rules (database not accessible from internet)
# ✓ Enable PostgreSQL SSL connections
# ✓ Rotate JWT_SECRET regularly
# ✓ Implement request signing for inter-service communication
# ✓ Enable audit logging for all admin actions
# ✓ Use HTTPS/TLS for all API endpoints
# ✓ Implement DDoS protection (Cloudflare, AWS WAF)
# ✓ Set up monitoring/alerting for security events
#
# ============================================================================
