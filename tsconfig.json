{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./services/*/src"],
      "@shared/*": ["./packages/shared/src"],
      "@entities/*": ["./packages/entities/src"]
    }
  },
  "include": ["services/**/*", "packages/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
