{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "paths": {
      "@/shared/*": ["./shared/*"],
      "@/middleware/*": ["./middleware/*"],
      "@/services/*": ["./services/*"],
      "@/routes/*": ["./routes/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "**/*.spec.ts"]
}
